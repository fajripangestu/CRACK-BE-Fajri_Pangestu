// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  password      String
  refresh_token String?
  role          Role       @default(USER)
  department    Department @default(CUSTOMER)
  position      Position   @default(CUSTOMER)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  histories        UserHistory[]    @relation("HistoryOf")
  modifications    UserHistory[]    @relation("ModifiedBy")
  customer_orders  CustomerOrder[]  @relation("OrderedBy")
  customer_details CustomerDetail[] @relation("Customer_Detail")
  approvalDecisions CustomerOrderApproval[] @relation("ApprovalDecidedBy")
  customerOrderHistoryChanges CustomerOrderHistory[] @relation("CustomerOrderHistoryChangedBy")
  activityLogs      ActivityLog[]            @relation("ActivityLogActor")
}

model ActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  action       String
  module       String?
  description  String?
  entityType   String?
  entityId     String?  @db.Uuid
  method       String?
  endpoint     String?
  referer      String?
  statusCode   Int?
  ipAddress    String?
  userAgent    String?
  browser      String?
  os           String?
  deviceType   String?
  language     String?
  timezone     String?
  screenWidth  Int?
  screenHeight Int?
  createdAt    DateTime @default(now())

  user User? @relation("ActivityLogActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model UserHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  userName    String?
  field       String
  oldValue    String?
  newValue    String?
  action      String   @default("EDIT")
  status      Boolean  @default(true)
  changedAt   DateTime @default(now())
  changedBy   String?  @db.Uuid

  modifier User? @relation("ModifiedBy", fields: [changedBy], references: [id], onDelete: SetNull)
  user     User? @relation("HistoryOf", fields: [userId], references: [id], onDelete: SetNull)
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  USER
}

enum Department {
  PRODUCTION
  QA
  PPC
  PROCUREMENT
  ENGINEER
  IT
  SALES
  WAREHOUSE
  MAINTENANCE
  HRD
  OWNER
  CUSTOMER
  OTHER
}

enum Position {
  OWNER
  GENERAL_MANAGER
  CONSULTANT
  GM_ASSISTANT
  MANAGER
  SUPERVISOR
  TEAM_LEADER
  ENGINEER
  ADMINISTRATIVE_STAFF
  OPERATOR
  TESTER
  CUSTOMER
  INTERNSHIP
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Dimension {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  unit      String
  thickness Float
  width     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product_name[]
}

model WidthStandard {
  id                  String   @id @default(uuid()) @db.Uuid
  standardName        String
  itemType            String
  unit                String
  lowerRangeWidth     Float
  upperRangeWidth     Float
  minusWidthTolerance Float
  plusWidthTolerance  Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ThicknessStandard {
  id                      String   @id @default(uuid()) @db.Uuid
  standardName            String
  itemType                String
  unit                    String
  lowerRangeWidth         Float
  upperRangeWidth         Float
  lowerRangeThickness     Float
  upperRangeThickness     Float
  minusThicknessTolerance Float
  plusThicknessTolerance  Float
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model YSStandard {
  id               String   @id @default(uuid()) @db.Uuid
  standardName     String
  itemType         String
  unit             String
  YS               Int
  minusYSTolerance Float
  plusYSTolerance  Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TSStandard {
  id               String   @id @default(uuid()) @db.Uuid
  standardName     String
  itemType         String
  unit             String
  TS               Int
  minusTSTolerance Float
  plusTSTolerance  Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ElongationStandard {
  id               String   @id @default(uuid()) @db.Uuid
  standardName     String
  itemType         String
  unit             String
  Elongation       Float
  minusElTolerance Float
  plusElTolerance  Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Lab_result {
  id           String   @id @default(uuid()) @db.Uuid
  productCode  String   @unique
  YS           Int
  TS           Int
  Elongation   Float
  Coating_mass Float
  BMT          Float
  TCT          Float
  Width        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductInspectionResult {
  id          String @id @default(uuid()) @db.Uuid
  productCode String @unique
}

model Coating_composition {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  Zn        Float
  Al        Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coating {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String       @unique
  Type               Coating_type
  Coating_mass       Int
  Chemical_treatment String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Material_location {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String
  location    String
  description String
  createdBy   String
  updateBy    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product_name {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  type      Product_type
  grade     String
  coating   String
  standard  String
  delivery  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  createdBy String
  updatedBy String
  ordered   Boolean      @default(false)

  dimensionId    String @db.Uuid
  dimension      Dimension       @relation(fields: [dimensionId], references: [id])
  customerOrders CustomerOrder[]
}

enum Product_type {
  Revolume
  Revxium
}

enum Coating_type {
  Al_Zn
  Zn
}

enum Product_status {
  Prime
  Medium
  Second
  Downgrade
  Hold
}

enum Chemical_Treatment {
  Clear_Resin
  Tinted_Resin
  Passivation
}

model CustomerOrder {
  id                String @id @default(uuid()) @db.Uuid
  SO                String
  productName       String
  productNameId     String? @db.Uuid

  product Product_name? @relation(fields: [productNameId], references: [id])

  productType       Product_type
  coatingType       Coating_type
  coatingMass       Int
  TCT               Float
  minTCT            Float
  maxTCT            Float
  BMT               Float
  minBMT            Float
  maxBMT            Float
  width             Float
  minWidth          Float
  maxWidth          Float
  Grade             String
  YS                Int
  minYS             Int
  maxYS             Int
  TS                Int
  minTS             Int
  maxTS             Int
  EL                Float
  minEL             Float
  maxEL             Float
  chemicalTreatment Chemical_Treatment
  minCoilWeight     Int
  maxCoilWeight     Int
  totalQuantity     Int
  export            String
  deliveryTime      DateTime
  orderStatus       String
  orderAt           DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  note              String

  userId String @db.Uuid
  user   User   @relation("OrderedBy", fields: [userId], references: [id])

  customerDetailId String @db.Uuid
  customerDetail   CustomerDetail @relation("OrderedBy", fields: [customerDetailId], references: [id])

  approvals CustomerOrderApproval[]
  history   CustomerOrderHistory[]
}

model CustomerOrderHistory {
  id              String   @id @default(uuid()) @db.Uuid
  customerOrderId String   @db.Uuid
  field           String
  oldValue        String?
  newValue        String?
  action          String   @default("UPDATE")
  changedAt       DateTime @default(now())
  changedById     String?  @db.Uuid
  changedByName   String?

  customerOrder CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  changedBy     User?         @relation("CustomerOrderHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([customerOrderId, changedAt])
  @@index([changedById])
}

model CustomerOrderApproval {
  id              String         @id @default(uuid()) @db.Uuid
  customerOrderId String         @db.Uuid
  department      Department
  position        Position
  status          ApprovalStatus @default(PENDING)
  decidedById     String?        @db.Uuid
  decidedAt       DateTime?
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customerOrder CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  decidedBy     User?         @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([customerOrderId, department, position])
  @@index([decidedById])
}

model CustomerDetail {
  id             String   @id @default(uuid()) @db.Uuid
  companyName    String
  companyAddress String
  contactPerson  String
  email          String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String @db.Uuid
  user   User   @relation("Customer_Detail", fields: [userId], references: [id])

  customer_orders CustomerOrder[] @relation("OrderedBy")
}
