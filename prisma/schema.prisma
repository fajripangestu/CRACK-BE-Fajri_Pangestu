// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  refresh_token String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  histories     UserHistory[] @relation("HistoryOf")
  modifications UserHistory[] @relation("ModifiedBy")
}

model UserHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())

  changedBy Int
  modifier  User     @relation("ModifiedBy",fields: [changedBy], references: [id])

  user      User     @relation("HistoryOf",fields: [userId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model Dimension {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  thickness Float
  width     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lab_result {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  Tensile      Int
  Yield        Int
  Elongation   Float
  Coating_mass Float
  BMT          Float
  TCT          Float
  Width        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Coating_composition {
  id        Int      @id @default(autoincrement())
  name      String
  Zn        Float
  Al        Float
  Ti        Float
  Si        Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coating {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  Type               Coating_type
  Coating_mass       Int
  Chemical_treatment String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Material_location {
  id          Int      @id @default(autoincrement())
  name        String
  code        String
  location    String
  description String
  createdBy   String
  updateBy    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product_name {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  type       Product_type
  dimension  String
  grade      String
  coating    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  updatedBy  String
  ordered    Boolean
}

enum Product_type {
  Revolume
  Revxium
}

enum Coating_type {
  Al_Zn
  Zn
}

enum Product_status {
  Prime
  Medium
  Second
  Downgrade
  Hold
}

enum Chemical_Treatment {
  Clear_Resin
  Tinted_Resin
  Passivation
}

model example {
  id Int @id @default(autoincrement())
  name String
}

model CustomerOrder {
  id Int @id @default(autoincrement())
  userId Int
  SO String
  productName Int
  productType Product_type
  coatingType Coating_type
  coatingMass Int
  TCT Float
  minTCT Float
  maxTCT Float
  BMT Float
  minBMT Float
  maxBMT Float
  width Float
  minWidth Float
  maxWidth Float
  Grade String
  YS Int
  minYS Int
  maxYS Int
  TS Int
  minTS Int
  maxTS Int
  EL Float
  minEL Float
  maxEL Float
  chemicalTreatment Chemical_Treatment
  customerDetail Int
  minCoilWeight Int
  maxCoilWeight Int
  totalQuantity Int
  export String
  deliveryTime DateTime
  productionStatus String
  orderAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  note String
}
