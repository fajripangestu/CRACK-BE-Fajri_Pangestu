// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  refresh_token String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model Dimension {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  thickness Float
  width     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lab_result {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  Tensile      Int
  Yield        Int
  Elongation   Float
  Coating_mass Float
  BMT          Float
  TCT          Float
  Width        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Coating_composition {
  id        Int      @id @default(autoincrement())
  name      String
  Zn        Float
  Al        Float
  Ti        Float
  Si        Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coating {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  Type               Coating_type
  Coating_mass       Int
  Chemical_treatment String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Material_location {
  id          Int      @id @default(autoincrement())
  name        String
  code        String
  location    String
  description String
  createdBy   String
  updateBy    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product_name {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  type       Product_type
  dimension  String
  grade      String
  coating    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  updatedBy  String
}

enum Product_type {
  Revolume
  Revxium
}

enum Coating_type {
  Al_Zn
  Zn
}

enum Product_status {
  Prime
  Medium
  Second
  Downgrade
  Hold
}
